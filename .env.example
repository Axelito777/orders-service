# Copia a .env y completa. Sin valores reales en el repo.
# Brokers de Kafka (KAFKA_PUBLIC_HOST de kafka-infra)
KAFKA_BOOTSTRAP_SERVERS=kafka-host:9092,kafka-host:9093,kafka-host:9094
# Máximo (ms) que se espera a Kafka al publicar; si se supera, la compra sale igual
KAFKA_MAX_BLOCK_MS=1500
# Azure Entra ID (identificadores públicos; por defecto ya vienen los del proyecto)
AZURE_TENANT_ID=tu-tenant-id
AZURE_CLIENT_ID=tu-client-id-de-la-api
# ms-pago (antifraude). En la EC2 los servicios comparten el docker-compose: usar el nombre del servicio
MS_PAGO_URL=http://ms-pago:8087
# Máximo (ms) que se espera a ms-pago; si no responde, se deja pasar (fail-open)
MS_PAGO_TIMEOUT_MS=1500
